# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token
# Chat that receives leads (your user id or a group id, e.g. -1001234567890)
LEADS_CHAT_ID=123456789
# HTTP endpoint for website forms
PORT=3000
# Allowed origins for browser forms, comma separated ("*" to allow any)
ALLOWED_ORIGINS=https://example.com
# Optional shared secret: forms/servers send it in the X-Lead-Secret header
LEAD_SECRET=
# Where leads are stored (CSV)
LEADS_FILE=leads.csv
